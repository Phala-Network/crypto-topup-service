// Markdown lint of the documentation (CI's docs job; CONTRIBUTING.md, "Documentation").
{
  "config": {
    "default": true,
    // Prose wraps at 100 columns; tables, links, and commands cannot.
    "MD013": false,
    // Tables use the compact `|---|` delimiter row.
    "MD060": false,
    // Changelogs repeat `Added`, `Changed`, ... under each release.
    "MD024": { "siblings_only": true },
    // Explicit anchors that keep existing links working, and the README's logo, which follows
    // GitHub's light or dark theme.
    "MD033": { "allowed_elements": ["a", "p", "picture", "source", "img"] },
    // The README's logo comes before its heading.
    "MD041": { "allow_preamble": true }
  },
  "gitignore": true,
  "globs": ["**/*.md"],
  // Submodules, and the pull request template, which starts at a second-level heading.
  "ignores": ["contracts/lib/**", ".github/PULL_REQUEST_TEMPLATE.md"]
}
