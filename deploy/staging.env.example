AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
SENTRY_DSN=
# TOPUP_RPC_<ID>_KEY: the API key RPC provider <ID>'s attested URL takes in place of its {key},
# empty for a keyless URL; one per provider of docker-compose.yml's x-rpc-providers that has one.
TOPUP_RPC_PROVIDER_A_KEY=
TOPUP_RPC_PROVIDER_B_KEY=
