# The staging reference product: sdk/examples/phala_cloud_integration.py in `serve` mode, with the
# SDK installed from uv.lock. Same pinned uv/Python image as deploy/sandbox/run-local.sh and the
# CVM rehearsal. Configuration comes from /etc/product/config.json and the ledger lives in /data.
FROM ghcr.io/astral-sh/uv:0.12.18-python3.14-trixie-slim@sha256:00facf17b58b02b725155862c5cd637f688f906bf7eb5b5194647886d8805cf3

ARG SOURCE_DATE_EPOCH
ENV UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/sdk/src

WORKDIR /opt/sdk
COPY sdk/python/pyproject.toml sdk/python/uv.lock sdk/python/README.md sdk/python/.python-version ./
# Runtime dependencies only, exactly as locked. The SDK itself is imported from source
# (PYTHONPATH): installing the local project records build-time mtimes, so two builds differ.
RUN uv sync --locked --no-dev --no-install-project --no-cache
COPY sdk/python/src ./src
COPY sdk/examples/phala_cloud_integration.py /opt/product/phala_cloud_integration.py

# Named volumes copy this directory's ownership, so the ledger is writable by the service user.
RUN mkdir /data && chown 10001:10001 /data
USER 10001:10001
EXPOSE 8089
ENTRYPOINT ["/opt/venv/bin/python", "/opt/product/phala_cloud_integration.py"]
CMD ["serve", "--config", "/etc/product/config.json"]
