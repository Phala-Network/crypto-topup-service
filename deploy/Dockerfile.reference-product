# The staging reference product: deploy/product/reference_product in `serve` mode, with the SDK and
# the product dependency group installed from uv.lock. Same pinned uv/Python image as
# deploy/sandbox/run-local.sh and the CVM rehearsal. Configuration comes from
# /etc/product/config.json and the ledger lives in /data. It serves the demo's API only: the
# website (deploy/product/web) is built and served by Cloudflare (deploy/phala.md, "Website").

FROM ghcr.io/astral-sh/uv:0.12.18-python3.14-trixie-slim@sha256:00facf17b58b02b725155862c5cd637f688f906bf7eb5b5194647886d8805cf3

ARG SOURCE_DATE_EPOCH
ENV UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/sdk/src:/opt/product

WORKDIR /opt/sdk
COPY sdk/python/pyproject.toml sdk/python/uv.lock sdk/python/README.md sdk/python/.python-version ./
# Runtime and product dependencies only, exactly as locked. The SDK itself is imported from source
# (PYTHONPATH): installing the local project records build-time mtimes, so two builds differ.
# The eth-abi, eth-rlp, and hexbytes wheels each ship their Sphinx sources as a top-level `docs`
# directory with different files at the same paths; uv installs wheels in parallel, so which copy
# survives varies between builds (`--preview-features detect-module-conflicts` reports the race).
# Nothing imports it; removing it keeps the layer reproducible.
RUN uv sync --locked --no-default-groups --group product --no-install-project --no-cache && \
    rm -r /opt/venv/lib/python3.14/site-packages/docs
COPY sdk/python/src ./src
COPY deploy/product/reference_product /opt/product/reference_product

# Named volumes copy this directory's ownership, so the ledger is writable by the service user.
RUN mkdir /data && chown 10001:10001 /data
USER 10001:10001
EXPOSE 8089
ENTRYPOINT ["/opt/venv/bin/python", "-m", "reference_product"]
CMD ["serve", "--config", "/etc/product/config.json"]
