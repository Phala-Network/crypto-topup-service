FROM postgres:16@sha256:a3b7f434b2dc57ce85a67e171163eb8ab1a1ebcb39d27484661f26b1dfbe30d6 AS wal-g-download

ARG TARGETARCH
ARG WAL_G_VERSION=3.0.9
ARG WAL_G_AMD64_SHA256=d6795c663894d836ba20840bffe8970aed81bbe25d3151bd4951f6f9c362def9
ARG WAL_G_ARM64_SHA256=072eb4a4a119f817e1fa888c64a776b01e3453b2e0d967a67d149adb18fde652

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl && \
    set -eu; \
    case "$TARGETARCH" in \
        amd64) wal_g_arch=amd64; wal_g_sha256="$WAL_G_AMD64_SHA256" ;; \
        arm64) wal_g_arch=aarch64; wal_g_sha256="$WAL_G_ARM64_SHA256" ;; \
        *) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    url="https://github.com/wal-g/wal-g/releases/download/v${WAL_G_VERSION}/wal-g-pg-22.04-${wal_g_arch}"; \
    curl -fsSL "$url" -o /wal-g; \
    echo "$wal_g_sha256  /wal-g" | sha256sum -c -; \
    chmod 0755 /wal-g

FROM postgres:16@sha256:a3b7f434b2dc57ce85a67e171163eb8ab1a1ebcb39d27484661f26b1dfbe30d6

COPY --from=wal-g-download /wal-g /usr/local/bin/wal-g
COPY deploy/scripts/postgres-walg-entrypoint.sh /usr/local/bin/postgres-walg-entrypoint
COPY deploy/scripts/walg-cron /usr/local/bin/walg-cron

ENTRYPOINT ["postgres-walg-entrypoint"]
CMD ["postgres"]
