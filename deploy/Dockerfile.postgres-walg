FROM postgres:18.6-trixie@sha256:86c951e05bf56c93d95d397747fb8820ac76cc3bedb78f43abd83eedbe3666ae AS wal-g-download

ARG TARGETARCH
ARG WAL_G_VERSION=3.0.9
ARG WAL_G_AMD64_SHA256=8015836f246a978f27b31a2462eac7765312558ae5b11ac033322b555abf9e22
ARG WAL_G_ARM64_SHA256=1edd72c3387bfc3a1c19acad9daa36709dbb7cff0642f7044e175d5f8b555d64

# ca-certificates: WAL-G verifies the object store's TLS certificate (R2/S3 over HTTPS).
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl && \
    set -eu; \
    case "$TARGETARCH" in \
        amd64) wal_g_arch=amd64; wal_g_sha256="$WAL_G_AMD64_SHA256" ;; \
        arm64) wal_g_arch=aarch64; wal_g_sha256="$WAL_G_ARM64_SHA256" ;; \
        *) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    url="https://github.com/wal-g/wal-g/releases/download/v${WAL_G_VERSION}/wal-g-pg-24.04-${wal_g_arch}"; \
    curl -fsSL "$url" -o /wal-g; \
    echo "$wal_g_sha256  /wal-g" | sha256sum -c -; \
    chmod 0755 /wal-g

FROM postgres:18.6-trixie@sha256:86c951e05bf56c93d95d397747fb8820ac76cc3bedb78f43abd83eedbe3666ae

# ca-certificates: WAL-G verifies the object store's TLS certificate (R2/S3 over HTTPS).
# liburi-perl: the entrypoint parses AWS_ENDPOINT with Perl's standard URI module (RFC 3986).
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates jq liburi-perl && \
    rm -rf /var/lib/apt/lists/*

# PostgreSQL 18 images declare VOLUME /var/lib/postgresql and default PGDATA to a major-version
# subdirectory. The compose mounts the volume there and keeps the cluster at a fixed path, which the
# backup, restore, and drill commands use; the empty 0700 directory seeds new volumes.
ENV PGDATA=/var/lib/postgresql/data
RUN install -d -o postgres -g postgres -m 0700 "$PGDATA"

COPY --from=wal-g-download /wal-g /usr/local/bin/wal-g
COPY deploy/scripts/postgres-walg-entrypoint.sh /usr/local/bin/postgres-walg-entrypoint
COPY deploy/scripts/walg-cron /usr/local/bin/walg-cron
COPY deploy/scripts/walg-timeline-backup /usr/local/bin/walg-timeline-backup
COPY deploy/scripts/walg-restore-command /usr/local/bin/walg-restore-command

ENTRYPOINT ["postgres-walg-entrypoint"]
CMD ["postgres"]
