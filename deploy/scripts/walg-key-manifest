#!/bin/sh
set -eu

if [ "$#" -ne 2 ]; then
    echo "usage: walg-key-manifest KIND OBJECT" >&2
    exit 64
fi

kind=$1
object=$2
version=${TOPUP_BACKUP_KEY_VERSION:-}
case "$kind" in
    base|wal) ;;
    *) echo "backup manifest kind must be base or wal" >&2; exit 64 ;;
esac
case "$object" in
    ''|*[!A-Za-z0-9_.-]*) echo "backup manifest object name is invalid" >&2; exit 64 ;;
esac
case "$version" in
    ''|*[!0-9]*) echo "TOPUP_BACKUP_KEY_VERSION must be a decimal integer" >&2; exit 64 ;;
esac

walg=${WALG_BIN:-wal-g}
tmp=$(mktemp)
cleanup() {
    rm -f "$tmp"
}
trap cleanup EXIT INT TERM

jq -cn \
    --arg kind "$kind" \
    --arg object "$object" \
    --argjson key_version "$version" \
    '{format: 1, kind: $kind, object: $object, key_version: $key_version}' >"$tmp"
"$walg" st put --force --no-compress --no-encrypt \
    "$tmp" "key-versions/$kind/$object.json"
"$walg" st put --force --no-compress --no-encrypt \
    "$tmp" key-versions/current.json
